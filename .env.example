RETRY_EXECUTOR=stub
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MODEL_BACKEND=prompted
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434

# Get a key at https://console.groq.com -> API Keys -> Create Key. Needed either
# way: for the rubric-eval judge (see below), and additionally for the escalation
# agent itself if MODEL_BACKEND=groq_prompted (routes the agent through a much
# larger model hosted on Groq instead of local Ollama — see docs/build_log.md
# Phase 3 for the local-vs-hosted trade-off).
GROQ_API_KEY=
# Only used when MODEL_BACKEND=groq_prompted. Default qwen/qwen3.8-27b (27B).
GROQ_AGENT_MODEL=qwen/qwen3.8-27b

# LLM-judge for the escalation rubric eval (scripts/run_escalation_rubric_eval.py).
# Judge must be materially stronger than the agent under test — the script picks
# the judge automatically per --backend (see JUDGE_MODEL_BY_BACKEND in
# evaluation/experiments/run_escalation_rubric_eval.py): qwen/qwen3.8-27b for the
# local Ollama agent, openai/gpt-oss-120b for the groq_prompted agent.
